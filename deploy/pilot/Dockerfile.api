# Multi-architecture registry digests verified from GHCR/Docker Hub on 2026-07-29.
FROM --platform=linux/amd64 ghcr.io/astral-sh/uv:0.8.14@sha256:f3660c56d5b08d6c516360981bedc439f499b9bf37f46a216018da3777a74011 AS uv
FROM --platform=linux/amd64 python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ARG TARGETARCH
RUN test "$TARGETARCH" = "amd64"
ADD --checksum=sha256:bdc69c09cbdd6cf8b1f333d372a1f58247b3a33146406333e30c0f26e8f51377 \
    https://github.com/FiloSottile/age/releases/download/v1.3.1/age-v1.3.1-linux-amd64.tar.gz \
    /tmp/age.tar.gz
RUN tar -C /tmp -xzf /tmp/age.tar.gz \
    && install -m 0755 /tmp/age/age /usr/local/bin/age \
    && rm -rf /tmp/age /tmp/age.tar.gz

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY deploy/pilot/api-requirements.lock /tmp/api-requirements.lock
RUN uv pip sync --system --require-hashes /tmp/api-requirements.lock \
    && rm /tmp/api-requirements.lock

COPY alembic.ini /app/alembic.ini
COPY migrations /app/migrations
COPY protector /app/protector
COPY scripts/pilot /app/scripts/pilot
RUN command -v age >/dev/null && command -v openssl >/dev/null

RUN groupadd --gid 10001 kuzet \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent kuzet \
    && mkdir -p /run/kuzet/health \
    && chown -R 10001:10001 /run/kuzet

USER 10001:10001
EXPOSE 8000
ENTRYPOINT ["uvicorn"]
CMD ["protector.pilot.api.production:create_production_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "172.30.0.10", "--no-server-header"]
